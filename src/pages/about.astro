            class="px-3 py-1.5 text-sm bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 hover:border-blue-400 transition-all shadow-sm">
            SBMF 2020 - Virtual
          </a>
          
          <a href="https://link.springer.com/conference/sbmf" target="_blank" rel="noopener noreferrer" 
            class="px-3 py-1.5 text-sm bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-800 rounded-lg text-blue-700 dark:text-blue-300 hover:bg-blue-100 dark:hover:bg-blue-900/50 transition-all shadow-sm">
            📚 Springer Link
          </a>
        </div>
      </div>
    </div>


  </div>
</section>
