const getHotelNotes = (hotel: (typeof hotels)[number]) => promotionNotes[hotel.name] ?? hotel.notes;
const getNoteParts = (notes: string) => {
  const parts: Array<{ text: string; url?: string }> = [];
  const urlPattern = /https?:\/\/[^\s]+/g;
  let lastIndex = 0;
  let match;

  while ((match = urlPattern.exec(notes))) {
    const rawUrl = match[0];
    const url = rawUrl.replace(/[.,;]+$/, '');
    const trailing = rawUrl.slice(url.length);
    if (match.index > lastIndex) parts.push({ text: notes.slice(lastIndex, match.index) });
    parts.push({ text: url, url });
    if (trailing) parts.push({ text: trailing });
    lastIndex = match.index + rawUrl.length;
  }

  if (lastIndex < notes.length) parts.push({ text: notes.slice(lastIndex) });
  return parts;
};
const getHotelLabel = (hotel: (typeof hotels)[number]) => {
  if (getHotelNotes(hotel).includes('SBMF')) return 'SBMF participant offer';
  return undefined;
};
