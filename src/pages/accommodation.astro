<section id="accommodation" class="mx-auto max-w-4xl px-6 py-12 text-slate-800 sm:py-16 dark:text-slate-200">
  <div class="border-b border-slate-200 pb-8 dark:border-slate-800">
    <h2 class="mb-4 text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Accommodation</h2>
    <p class="leading-relaxed text-slate-600 dark:text-slate-400">
      The hotels below have provided information for SBMF 2026 participants. Please contact each hotel directly to confirm rates, availability and booking conditions.
    </p>
  </div>

  <div class="space-y-9 py-8">
    {neighborhoods.map((neighborhood) => (
      <div>
        <h3 class="mb-3 text-lg font-semibold text-slate-900 dark:text-white">{neighborhood}</h3>
        <div class="divide-y divide-slate-200 border-y border-slate-200 dark:divide-slate-800 dark:border-slate-800">
          {hotels.filter((hotel) => hotel.neighborhood === neighborhood).map((hotel) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-slate-800 marker:content-none dark:text-slate-200">
                <span class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1">
                  <span>{hotel.name}</span>
                  {getHotelLabel(hotel) && (
                    <span class="rounded-full bg-blue-50 px-2 py-0.5 text-xs font-semibold text-blue-700 dark:bg-blue-900/30 dark:text-blue-300">
                      {getHotelLabel(hotel)}
                    </span>
                  )}
                </span>
                <span class="text-blue-600 transition-transform group-open:rotate-180 dark:text-blue-400" aria-hidden="true">⌄</span>
              </summary>
              <div class="pt-4 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                <p><span class="font-semibold text-slate-800 dark:text-slate-200">Address: </span>{hotel.address}</p>
                <p><span class="font-semibold text-slate-800 dark:text-slate-200">Phone: </span>{hotel.phone}</p>
                <p><span class="font-semibold text-slate-800 dark:text-slate-200">Email: </span><a class="text-blue-600 hover:underline dark:text-blue-400" href={`mailto:${hotel.email.split('; ')[0]}`}>{hotel.email}</a></p>
                <p class="mt-3"><span class="font-semibold text-slate-800 dark:text-slate-200">Information: </span>{getNoteParts(getHotelNotes(hotel)).map((part) => part.url ? <a href={part.url} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline dark:text-blue-400 break-all">{part.text}</a> : part.text)}</p>
                <a href={hotel.website} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex font-semibold text-blue-600 hover:underline dark:text-blue-400">Visit hotel website <span aria-hidden="true" class="ml-1">→</span></a>
              </div>
            </details>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
