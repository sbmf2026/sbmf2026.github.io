---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Countdown from '~/pages/countdown.astro';
import About from '~/pages/about.astro';
import Program from '~/pages/program.astro';
import ScopeTopics from '~/pages/scope_topics.astro';
import Talks from '~/pages/talks.astro';
import ImportantDate from '~/pages/important-date.astro';
import Registration from '~/pages/registration.astro';
import Committees from '~/pages/committees.astro';
import Submission from '~/pages/submission.astro';
import bgImage from '~/assets/images/image2.jpg';
import logoNovo from '~/assets/images/logo_sbmf_vertical.png';
import logoSbc from '~/assets/images/logo-sbc.png';


const metadata = {
  title: '29th Brazilian Symposium on Formal Methods',
  ignoreTitleTemplate: true,
};

const revealOnScrollClass = 'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade';
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero>
    <Fragment slot="title">
      <div class="mx-auto grid w-full max-w-8xl grid-cols-1 items-center gap-8 
        md:grid-cols-[minmax(80px,140px)_minmax(0,3fr)_minmax(80px,140px)] 
        md:gap-8 lg:gap-10">
        <div class="flex justify-center md:justify-start">
          <img
            src={logoNovo.src}
            alt="SBMF 2026"
            loading="eager"
             class="h-20 w-20 object-contain opacity-95
              sm:h-24 sm:w-24
              md:h-28 md:w-28
              lg:h-32 lg:w-32"
          />
        </div>

        <div class="w-full space-y-4 text-center">
          <span class="block w-full text-4xl font-bold tracking-tight drop-shadow-md md:text-5xl lg:text-6xl">
            29th Brazilian Symposium on Formal Methods
          </span>

          <div class="space-y-4">
            <h2 class="text-2xl md:text-3xl font-bold tracking-tight">
              December 1-4, 2026
            </h2>

            <div class="inline-block rounded-xl bg-white/70 backdrop-blur-md px-6 py-3 shadow-lg dark:bg-slate-900/60">
              <Countdown classes={{ container: 'py-0' }} />
            </div>
          </div>
        </div>

      <div class="flex justify-center md:justify-end">
          <div class="rounded-2xl bg-white/70 backdrop-blur-md p-3 shadow-lg dark:bg-slate-900/60">
            <img
              src={logoSbc.src}
              alt="SBMF logo SBC"
              loading="eager"
              class="h-20 w-20 object-contain opacity-95
              sm:h-24 sm:w-24
              md:h-28 md:w-28
              lg:h-32 lg:w-32"
            />
          </div>
        </div>
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 max-h-screen md:max-h-[600px] lg:max-h-[700px] overflow-hidden">
        <img 
          src={bgImage.src}
          alt="City Background" 
          class="w-full h-full object-cover object-bottom"
        />
        
        <div class="absolute inset-0 bg-gradient-to-b from-white/95 via-white/40 to-transparent dark:from-slate-900 dark:via-slate-900/60 dark:to-transparent"></div>
      </div>
    </Fragment>
  </Hero>


  <div class={revealOnScrollClass}>
    <About />
  </div>

  <!--
  <div class={revealOnScrollClass}>
    <Program />
  </div>
-->

  <div class={revealOnScrollClass}>
    <ScopeTopics />
  </div>

  <!--
  <div class={revealOnScrollClass}>
    <Talks />
  </div>
   -->

  <div class={revealOnScrollClass}>
    <ImportantDate />
  </div>

  <div class={revealOnScrollClass}>
    <Registration />
  </div>

  <div class={revealOnScrollClass}>
    <Committees />
  </div>

  <div class={revealOnScrollClass}>
    <Submission />
  </div>

</Layout>
