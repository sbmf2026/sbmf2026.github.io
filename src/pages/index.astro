---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import AboutSBC from '~/components/widgets/AboutSBC.astro';
import Countdown from '~/pages/countdown.astro';
import About from '~/pages/about.astro';
import Program from '~/pages/program.astro';
import ScopeTopics from '~/pages/scope_topics.astro';
import Talks from '~/pages/talks.astro';
import ImportantDate from '~/pages/important-date.astro';
import Registration from '~/pages/registration.astro';
import Committees from '~/pages/committees.astro';
import Submission from '~/pages/submission.astro';
import ContactUs from '~/pages/contact-us.astro';
import bgImage from '~/assets/images/image2.jpg';
import logoNovo from '~/assets/images/logo_sbmf_vertical.png';
import logoSbcPortal from '~/assets/images/LogoSBCparaSite.png';
import logoSbc from '~/assets/images/logo-sbc.png';
import logo_puc from '~/assets/images/logo_puc.png';  


const metadata = {
  title: '29th Brazilian Symposium on Formal Methods',
  ignoreTitleTemplate: true,
};

const revealOnScrollClass = 'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade';
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero>
    <Fragment slot="title">
      <div class="mx-auto flex w-full max-w-6xl flex-col items-center gap-4 text-center">
        <div class="flex w-full items-center justify-center gap-4 sm:gap-7 md:gap-10 lg:gap-14">
          <img
            src={logoNovo.src}
            alt="SBMF 2026"
            loading="eager"
            class="hidden h-20 w-20 shrink-0 object-contain opacity-95 drop-shadow-xl pointer-events-none sm:block md:h-24 md:w-24 lg:h-28 lg:w-28"
          />
          <span class="block max-w-4xl font-serif text-3xl font-semibold leading-tight tracking-normal text-slate-900 sm:text-4xl md:text-5xl lg:text-6xl dark:text-white">
            29th Brazilian Symposium on Formal Methods
          </span>

          <a
            class="hidden shrink-0 sm:block"
            href="https://www.sbc.org.br"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Portal da SBC"
          >
            <span class="block rounded-xl bg-slate-950/75 p-2 backdrop-blur-md dark:bg-transparent dark:p-0 dark:backdrop-blur-none">
              <img src={logoSbcPortal.src} alt="Realização: SBC" class="h-20 w-auto object-contain drop-shadow-md md:h-24 lg:h-28" />
            </span>
          </a>
        </div>

        <div class="space-y-2">
          <div class="inline-block rounded-xl bg-white/70 px-6 py-2.5 shadow-lg backdrop-blur-md dark:bg-slate-900/60">
            <h2 class="font-sans text-2xl font-semibold tracking-tight text-slate-900 md:text-3xl dark:text-slate-100" style="text-shadow: 0 1px 1px rgba(255,255,255,0.35);" >
              December 1-4, 2026
            </h2>
            <Countdown classes={{ container: 'py-0' }} />
          </div>
        </div>
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 max-h-screen md:max-h-[600px] lg:max-h-[700px] overflow-hidden">
        <img 
          src={bgImage.src}
          alt="City Background" 
          class="w-full h-full object-cover object-bottom"
        />
        
        <div class="absolute inset-0 bg-gradient-to-b from-white/95 via-white/40 to-transparent dark:from-slate-900 dark:via-slate-900/60 dark:to-transparent"></div>
      </div>
    </Fragment>
  </Hero>


  <div class={revealOnScrollClass}>
    <About />
  </div>

  <!--
  <div class={revealOnScrollClass}>
    <Program />
  </div>
-->

  <div class={revealOnScrollClass}>
    <ScopeTopics />
  </div>

  <div class={revealOnScrollClass}>
    <ImportantDate />
  </div>

  <div class={revealOnScrollClass}>
    <Registration />
  </div>

  <div class={revealOnScrollClass}>
    <Talks />
  </div>

  <div>
    <Committees />
  </div>

  <div class={revealOnScrollClass}>
    <Submission />
  </div>

  <div class={revealOnScrollClass}>
    <AboutSBC />
  </div>

  <ContactUs />

  <footer class="mt-20 border-t border-slate-200 bg-slate-950 px-4 py-10 text-white dark:border-slate-800 sm:px-6">

  <div class="mx-auto flex max-w-7xl flex-col items-center justify-center gap-5 text-center">

    <div class="space-y-1">
      <p class="text-sm font-semibold uppercase tracking-[0.25em] text-slate-200">
        Host and co-host organizers
      </p>
    </div>

    <div class="flex items-center justify-center gap-5 sm:gap-6">
      
      <img
        src={logoSbc.src}
        alt="SBMF logo SBC"
        loading="lazy"
        class="h-14 w-14 object-contain opacity-100 brightness-0 invert sm:h-16 sm:w-16 md:h-20 md:w-20"
      />
       

      <img
        src={logo_puc.src}
        alt="PUC Rio"
        loading="lazy"
        class="h-14 w-14 object-contain opacity-100 brightness-0 invert sm:h-16 sm:w-16 md:h-20 md:w-20"
      />

    </div>

  </div>

</footer>

</Layout>
