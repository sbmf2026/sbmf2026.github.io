---
// src/components/widgets/Talks.astro
import { Image } from 'astro:assets';
import anaCavalcantiImage from '../assets/images/photos/ana-cavalcanti.jpg';
import antonioFilieriImage from '../assets/images/photos/AntonioFilieri.jpg';

// Definicao dos dados dos palestrantes para facilitar a manutencao
const speakers = [
  {
    name: 'Prof. Ana Cavalcanti',
    institution: 'University of York, UK',
    image: anaCavalcantiImage,
    link: 'https://www-users.york.ac.uk/~alcc500/',
    bio: 'Ana Cavalcanti is a Professor at the University of York, UK, and holds a Royal Academy of Engineering Chair in Emerging Technologies. In that role, she is Director of the RoboStar centre on Software Engineering for Robotics. She previously held a Royal Society Industry Fellowship, which provided her with the ideal opportunity to understand and contribute to the practice of formal methods working with QinetiQ. Her main scientific achievements have been on the design and justification of sound refinement-based program development and verification techniques. She has covered theoretical and practical integration with industry-strength technology: concurrency, object-orientation, and testing, dealing now with mobile and autonomous robots. She has led the development and justification of refinement theories, notations, and techniques, and tools to cope with control systems. Her work provides support for graphical notations popular with engineers, and for main-stream programming languages. It is distinctive in that it has comprehensive coverage of practical languages, rather than idealised notations. It also supports high degrees of automation to enable usability and scalability. She has chaired the Programme Committee of leading conferences, and been a member of numerous Programme Committees. Currently, she is the Chair of the Formal Methods Europe Board.',
  },
  {
    name: 'Antonio Filieri',
    institution: 'AWS and Imperial College London.',
    image: antonioFilieriImage,
    link: 'https://www.antonio.filieri.name/',
    bio: 'Antonio Filieri co-authored Empirical standards for software engineering research to define quality benchmarks for reporting and assessing qualitative and quantitative software studies. He is a Senior Applied Scientist at AWS and a Visiting Associate Professor at Imperial College London, where he works on automated reasoning for static analysis, test generation, and security. His research applies formal mathematical methods to software verification and self-adaptation, specifically using control theory to provide formal guarantees for adaptive systems. Filieri developed Run-time efficient probabilistic model checking and established methods for reliability analysis in Symbolic Pathfinder. He previously held a tenured Associate Professor position at Imperial College London and was an Assistant Professor at the University of Stuttgart. He specializes in probabilistic program analysis and the design of industry-strength formal methods for software security.',
  },
];
---

<section id="talks" class="mx-auto max-w-7xl px-4 sm:px-6 py-16 sm:py-20 text-slate-800 dark:text-slate-200">
  <div class="text-center mb-12 sm:mb-16">
    <p class="text-base text-blue-600 dark:text-blue-400 font-semibold tracking-wide uppercase">
      Speakers
    </p>
    <h2 class="text-4xl md:text-5xl font-bold tracking-tight mb-4 text-slate-900 dark:text-white">
      Special Talks
    </h2>
    <div class="w-24 h-1 bg-blue-600 mx-auto rounded mb-6"></div>
    <p class="max-w-3xl mx-auto text-xl text-slate-600 dark:text-slate-400">
      Meet our distinguished invited speakers for SBMF 2026.
    </p>
  </div>

  <div class="mx-auto grid max-w-7xl gap-8 md:gap-12 md:grid-cols-2">
    {speakers.map((speaker) => (
      <div class="bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-2xl p-6 sm:p-8 shadow-lg shadow-gray-100/50 dark:shadow-none flex flex-col items-center text-center transition hover:border-blue-300 dark:hover:border-blue-700 hover:shadow-xl">
        <a href={speaker.link} target="_blank" rel="noopener noreferrer" class="group flex flex-col items-center mb-6">
          <div class="mb-5 relative">
            <div class="absolute inset-0 bg-blue-600 rounded-full scale-105 blur opacity-20 group-hover:opacity-40 transition"></div>
            <Image
              src={speaker.image}
              alt={`Photo of ${speaker.name}`}
              width={300}
              height={300}
              class="relative rounded-full w-32 h-32 md:w-40 md:h-40 object-cover border-4 border-white dark:border-slate-800 shadow-md group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <h3 class="text-2xl font-bold text-slate-950 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition mb-1">
            {speaker.name}
          </h3>
          <p class="text-sm font-medium text-slate-500 dark:text-slate-500 uppercase tracking-wider">
            {speaker.institution}
          </p>
        </a>

        {speaker.title && (
          <div class="bg-blue-50 dark:bg-slate-800/50 border border-blue-100 dark:border-slate-700/50 rounded-xl p-5 mb-6 w-full grow flex flex-col justify-center">
            <p class="text-xs font-semibold text-blue-700 dark:text-blue-300 uppercase tracking-widest mb-2">Talk Title</p>
            <h4 class="text-lg font-semibold text-slate-900 dark:text-white leading-snug">
              "{speaker.title}"
            </h4>
          </div>
        )}

        {speaker.bio && (
          <div class="text-left w-full">
            <h5 class="text-sm font-semibold text-slate-900 dark:text-white mb-2">About the speaker</h5>
            <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed text-justify">
              {speaker.bio}
            </p>
          </div>
        )}
      </div>
    ))}
  </div>
</section>
