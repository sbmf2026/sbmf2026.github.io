  { time: '09:00 ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œ 10:00', activity: 'Keynote', title: 'Prof. Antonio Filieri', affiliation: 'Amazon Web Services & Imperial College London', abstractTitle: 'A Formal Methods RenAIssance: AI, Trust, and What Is Worth Proving', abstract: 'As AI agents take on more of the work of writing software, the questions of what to build and how to trust it become more pressing. The same technologies are also changing formal methods: they can propose invariants, guide proof search, and help construct machine-checked proofs, reducing some of the effort that has traditionally required specialist expertise. Meanwhile, greater reliance on generated code and the prospect of cheaper, more scalable attacks strengthen the case for rigorous assurance. This talk explores the opportunity created by these changes. Drawing on recent research and experiences at Amazon, we will examine how AI and formal methods can reinforce each other: AI helps produce candidate solutions and proofs, while formal tools provide precise feedback and checkable guarantees. The central question is what becomes most valuable as proof construction becomes more automated. A checked proof establishes a particular claim under particular assumptions; choosing that claim, validating those assumptions, and connecting them to the intended system remain essential. I will argue that this creates new opportunities for formal-methods experts to identify what is necessary and worth proving, develop useful abstractions, and build sound tools that agents can use. This also raises a challenge for education: how do we cultivate the judgment and understanding on which trustworthy automation depends?', type: 'keynote' },
  { time: '10:00 ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œ 10:30', activity: 'Coffee Break', type: 'break' },
  { time: '10:30 ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œ 11:30', activity: 'Session 6 ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â Strategic Reasoning and Multi-Agent Systems', chair: 'To be assigned', type: 'session' },
  { time: '10:30 ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œ 11:00', activity: 'Paper presentation', number: 'Paper 2', title: 'Strategy Synthesis in a Stochastic Generalised Dining Philosophers Game', authors: 'Luke Lawson, Nils Timm', abstract: 'The Dining Philosophers is a well-studied model that demonstrates basic challenges in concurrent programming, as well as resource allocation in multi-agent environments. Generalisations of the Dining Philosophers have been proposed that constitute generic multi-agent resource allocation (MRA) models, however, only fully deterministic generalisations are typically considered, limiting the models\' applicability to real-world distributed systems in which randomness occurs. We enhance a Generalised Dining Philosophers game model to incorporate random resource failures, developing a framework for modelling practical competitive resource allocation problems that involve probabilistic uncertainty. Strategy synthesis in the context of multi-player games is a technique whereby strategy profiles are constructed that, if followed by agents, can guarantee a specified desirable outcome or assertion. We implement an approach that uses PRISM-games, a probabilistic model checker, to synthesise strategies that meet optimality criteria or achieve a game equilibrium for the formulated Stochastic Generalised Dining Philosophers (SGDP) game. Furthermore, we describe symmetry in the SGDP game model and demonstrate the exploitation of symmetry arguments in reasoning about expected agent outcomes.', type: 'paper' },
  { time: '11:00 ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œ 11:30', activity: 'Paper presentation', number: 'Paper 3', title: 'Counterexample-Guided Abstraction Refinement for Nash Equilibrium Synthesis in Region-Control Multi-Agent Systems', authors: 'Steven Jordaan, Nils Timm', abstract: 'We develop a counterexample-guided abstraction refinement (CEGAR) approach for Nash equilibrium (NE) synthesis in region-control multi-agent systems (RCMAS). An RCMAS models agents competing to occupy sectors of a shared territory, with rewards based on cohesive region size. The SMT-based synthesis approach introduced in prior work does not scale well, as the search space grows rapidly with the size of the territory. Our new approach addresses this by merging sectors into weighted blocks via a territory partition, inducing a smaller abstract RCMAS on which synthesis becomes more efficient. A candidate NE is synthesised on the abstract instance, lifted to the concrete system, and verified; if a profitable deviation is found, this shows that the candidate NE is spurious. The deviation serves as a counterexample, which drives targeted partition refinement. We prove soundness and termination of the refinement loop, with a linear upper bound on the number of refinement iterations in the size of the territory. Experiments on grid territories confirm consistent speedups over direct synthesis and enable Nash equilibrium synthesis for instances previously intractable.', type: 'paper' },
  { time: '11:30 ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œ 12:30', activity: 'Closing Ceremony', description: 'Closing remarks ÃƒÆ’Ã¢â‚¬Å¡Ã‚Â· Best paper award ÃƒÆ’Ã¢â‚¬Å¡Ã‚Â· Announcement of SBMF 2027', type: 'ceremony' },
];

const repairEncoding = (value: string) => {
  const cleaned = value.replace(/[^\x00-\x7F]/g, '').replace(/\s{2,}/g, ' ').trim();
  return cleaned
    .replace(/(\d{2}:\d{2})\s+(\d{2}:\d{2})/g, '$1 - $2')
    .replaceAll('Genana Nunes', 'Gena\u00edna Nunes')
    .replaceAll('Gabriel Araujo', 'Gabriel Ara\u00fajo')
    .replaceAll('Flavio Leonardo', 'Fl\u00e1vio Leonardo')
    .replaceAll('Joao Paixao', 'Jo\u00e3o Paix\u00e3o');
};
---

<section id="program" class="program-page">
    <div class="mb-10 text-center">
      <h2 class="mb-4 text-3xl font-bold tracking-tight text-slate-900 md:text-4xl dark:text-white">Program</h2>
      <div class="mx-auto h-1 w-16 rounded bg-blue-600"></div>
    </div>
    <div class="program-wrap">
      <table><colgroup><col class="time-col" /><col class="activity-col" /><col /></colgroup><thead class="program-table-head"><tr><th>Time</th><th>Activity</th><th>Title / Description</th></tr></thead><tbody>
        {schedule.map((item) => item.day ? <tr class="day-header"><td colspan="3">{repairEncoding(item.day)}</td></tr> : item.type === 'break' ? <tr class="break-row"><td class="time">{repairEncoding(item.time)}</td><td colspan="2">{repairEncoding(item.activity)}</td></tr> : item.type === 'session' ? <tr class="session-row"><td class="time">{repairEncoding(item.time)}</td><td colspan="2"><strong>{repairEncoding(item.activity)}</strong><small>Session Chair: {repairEncoding(item.chair)}</small></td></tr> : <tr class:list={[item.type, { expandable: item.abstract }]}><td class="time">{repairEncoding(item.time)}</td><td class="activity">{repairEncoding(item.activity)}</td><td class="main">{item.number && <div class="paper-number">{repairEncoding(item.number)}</div>}{item.title ? item.abstract ? <button class="paper-title" type="button">{repairEncoding(item.title)}</button> : <span class="plain-title">{repairEncoding(item.title)}</span> : <span>{repairEncoding(item.description)}</span>}{item.authors && <div class="authors">{repairEncoding(item.authors)}</div>}{item.affiliation && <div class="affiliation">{repairEncoding(item.affiliation)}</div>}{item.abstract && <div class="abstract"><b>{repairEncoding(item.abstractTitle || 'Abstract')}</b><p>{repairEncoding(item.abstract)}</p></div>}</td></tr>)}
      </tbody></table>
    </div>
</section>

<script>
  document.querySelectorAll('.program-page tr.expandable').forEach((row) => {
    row.addEventListener('click', () => row.classList.toggle('open'));
  });
</script>

<style>
  .program-page{--navy:#0f172a;--blue:#2563eb;--blue-lt:#eff6ff;--bg:#f8fafc;--text:#1e293b;--muted:#64748b;--border:#e2e8f0;background:transparent;color:var(--text);min-height:calc(100vh - 5rem)}
  .program-page{padding-top:4rem;padding-bottom:1rem}
  .program-wrap{max-width:980px;margin:2.5rem auto 0;padding:0 1rem}table{width:100%;border-collapse:separate;border-spacing:0;background:#fff;border:1px solid #cbd5e1;border-radius:12px;overflow:hidden;box-shadow:0 1px 3px #0f172a0d, inset 0 0 0 1px #e2e8f0}.time-col{width:130px}.activity-col{width:175px}th{background:transparent;color:inherit;border-bottom:0;padding:1rem 1.5rem;font-size:.875rem;font-weight:600;text-align:left;text-transform:uppercase;letter-spacing:.05em}td{padding:.85rem 1.25rem;font-size:.88rem;vertical-align:top;border-bottom:1px solid #f1f5f9}tr:last-child td{border-bottom:0}.program-table-head{background:#f8fafc;border-bottom:1px solid #e2e8f0}.program-table-head th{color:#0f172a}.time{white-space:nowrap;color:var(--muted);font-size:.8rem}.activity{font-weight:600}.day-header td,.session-row td{background:#f8fafc;color:#0f172a;font-weight:600;border-bottom:1px solid #e2e8f0;padding:.85rem 1.25rem;font-size:.95rem}.session-row small{display:block;margin-top:.3rem;color:#64748b;font-weight:400}.ceremony td,.social td,.keynote td{background:var(--blue-lt);border-left:0}.break-row td{background:#f8fafc;color:var(--muted);font-style:italic;border-left:4px solid #cbd5e1}.paper:nth-child(even) td{background:#fcfdff}.expandable{cursor:pointer}.expandable:hover td{background:#f1f5f9}.paper-number{color:var(--muted);font-size:.72rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;margin-bottom:.25rem}.paper-title{display:flex;width:100%;align-items:baseline;justify-content:space-between;gap:.5rem;padding:0;border:0;background:none;color:var(--navy);font:600 .9rem/1.4 inherit;text-align:left;cursor:pointer}.paper-title:after{content:'ÃƒÆ’Ã‚Â¢Ã¢â‚¬â€œÃƒâ€šÃ‚Â¸';font-size:1.2em;color:var(--blue);opacity:.8;transition:transform .2s}.open .paper-title:after{transform:rotate(90deg)}.keynote .paper-title{color:var(--blue);font-size:.96rem}.plain-title{font-weight:600;color:var(--navy)}.authors,.affiliation{color:var(--muted);font-size:.82rem;margin-top:.25rem}.affiliation{color:var(--blue)}.abstract{display:none;margin-top:.75rem;padding:.75rem 1rem;border:1px solid #dbeafe;border-left:3px solid var(--blue);border-radius:.5rem;background:#f8fafc;font-size:.84rem}.open .abstract{display:block}.abstract b{display:block;color:var(--muted);font-size:.72rem;letter-spacing:.07em;text-transform:uppercase;margin-bottom:.35rem}.abstract p{margin:0}
  :global(.dark) .program-page{--bg:#0f172a;--text:#e2e8f0;--muted:#94a3b8;--border:#334155}:global(.dark) .program-page table{background:#0f172a;border-color:#475569;box-shadow:0 1px 3px #0008,inset 0 0 0 1px #334155}:global(.dark) .program-page .program-table-head{background:#1e293bcc;border-color:#334155}:global(.dark) .program-page .program-table-head th{color:#f8fafc}:global(.dark) .program-page td{border-color:#1e293b}:global(.dark) .program-page .day-header td,:global(.dark) .program-page .session-row td{background:#1e293b;color:#f8fafc;border-color:#334155}:global(.dark) .program-page .session-row small{color:#cbd5e1}:global(.dark) .program-page .activity{color:#f8fafc}:global(.dark) .program-page .paper-title{color:#f8fafc}:global(.dark) .program-page .paper:nth-child(even) td,:global(.dark) .program-page .break-row td{background:#111c2e}:global(.dark) .program-page .expandable:hover td{background:#1e293b}:global(.dark) .program-page .plain-title{color:#f8fafc}:global(.dark) .program-page .abstract{background:#172554;border-color:#1d4ed8}:global(.dark) .program-page .ceremony td,:global(.dark) .program-page .social td,:global(.dark) .program-page .keynote td{background:#172554}
  @media(max-width:600px){.program-wrap{padding:0 .5rem;margin-top:1.5rem}.time-col{width:84px}.activity-col{width:112px}td{padding:.55rem;font-size:.8rem}th{padding:.6rem .55rem}}
  .paper-title:after{content:'\25B8'}
</style>








