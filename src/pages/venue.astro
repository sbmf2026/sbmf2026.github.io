---
import campusMap from '~/assets/images/Mapa_PUC-Rio.png';
---

<section id="venue" class="mx-auto max-w-6xl px-6 py-12 text-slate-800 sm:py-16 dark:text-slate-200">
  <div class="border-y border-slate-200 py-8 dark:border-slate-800">
    <h2 class="mb-4 text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Venue</h2>
    <p class="leading-relaxed text-slate-600 dark:text-slate-400">
      All SBMF 2026 activities will take place at the <strong class="text-slate-800 dark:text-slate-200">Auditório Pe. Anchieta</strong>,
      on the ground floor of the <strong class="text-slate-800 dark:text-slate-200">Cardeal Leme Building</strong>, at
      <strong class="text-slate-800 dark:text-slate-200">PUC-Rio</strong> (Pontifical Catholic University of Rio de Janeiro).
    </p>

    <div class="mt-5 overflow-hidden rounded-lg border border-slate-200 shadow-sm dark:border-slate-700">
      <iframe
        title="Map to the Cardeal Leme Building at PUC-Rio"
        src="https://www.google.com/maps?q=-22.9800555,-43.2328334&z=17&output=embed"
        class="h-72 w-full border-0 sm:h-80"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
    <a
      href="https://www.google.com/maps/place/Edif%C3%ADcio+Cardeal+Leme+(PUC-Rio)/@-22.9800555,-43.2328334,17z"
      target="_blank"
      rel="noopener noreferrer"
      class="mt-3 inline-flex text-sm font-semibold text-blue-600 hover:underline dark:text-blue-400"
    >
      Open in Google Maps <span aria-hidden="true" class="ml-1">→</span>
    </a>

    <p class="mt-7 text-center text-sm leading-relaxed text-slate-600 dark:text-slate-400">
      For orientation on campus, please consult the PUC-Rio campus map below.
    </p>
    <a
      href={campusMap.src}
      target="_blank"
      rel="noopener noreferrer"
      class="mx-auto mt-4 block w-fit overflow-hidden rounded border border-slate-200 bg-white shadow-sm transition hover:border-blue-400 hover:shadow-md dark:border-slate-700 dark:bg-slate-800"
      aria-label="Open the PUC-Rio campus map in full size"
    >
      <img
        src={campusMap.src}
        alt="PUC-Rio campus map — click to open in full size"
        width={1585}
        height={1117}
        class="h-auto w-80 object-cover sm:w-96 md:w-[40rem]"
      />
    </a>
    <p class="mt-2 text-center text-xs text-slate-500 dark:text-slate-400">Click the map to view it in full size.</p>
  </div>
</section>
